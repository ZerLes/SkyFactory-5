{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "Obscure Tooltips Style",
  "description": "A Obscure Tooltips style datapack file",
  "type": "object",
  "properties": {
    "priority": {
      "type": "number"
    },
    "panel": {
      "type": "string"
    },
    "frame": {
      "type": "string",
      "description": "Optional frame texture id rendered around the tooltip."
    },
    "icon": {
      "type": "string"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enchantments": {
          "type": "object"
        },
        "tag": {
          "type": "object",
          "description": "Single-NBT-tag filter (used by some styles like example_style)."
        },
        "tags": {
          "type": "object",
          "description": "Multi-tag filter map."
        }
      }
    }
  },
  "required": ["priority", "panel", "icon", "effects", "filter"],
  "additionalProperties": false
}
